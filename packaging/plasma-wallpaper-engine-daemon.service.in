[Unit]
Description=Plasma Wallpaper Engine daemon (Vulkan scene compositor + dmabuf exporter)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%libexecdir%/plasma-wallpaper-engine-daemon
Restart=on-failure
RestartSec=2
# The daemon talks to the session bus and the compositor's IPC sockets;
# both live under the user's runtime directory.
Environment=QT_QPA_PLATFORM=wayland

[Install]
WantedBy=graphical-session.target
