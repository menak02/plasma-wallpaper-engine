#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;
layout(set = 0, binding = 1) uniform sampler2D maskImage;
layout(set = 0, binding = 2) uniform writeonly image2D outputImage;

layout(push_constant) uniform PulseParams {
    float speed;
    float amount;
    float power;
    float time;
    uint width;
    uint height;
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(params.width) || coord.y >= int(params.height)) {
        return;
    }

    float pulseFactor = 1.0 + params.amount * 0.15 * sin(params.time * params.speed * 4.0);
    float maskVal = texture(maskImage, vec2(float(coord.x) / float(params.width), float(coord.y) / float(params.height))).r;
    pulseFactor = mix(1.0, pulseFactor, maskVal);

    vec2 center = vec2(0.5, 0.5);
    vec2 uv = vec2(float(coord.x) / float(params.width), float(coord.y) / float(params.height));
    vec2 rel = uv - center;

    // Apply radial pulse
    float dist = length(rel);
    float maxDist = length(center);
    float influence = 1.0 - smoothstep(0.0, maxDist, dist);
    float scaledDist = pow(dist, params.power);
    uv = center + rel * (1.0 + (pulseFactor - 1.0) * influence);

    uv = clamp(uv, vec2(0.0), vec2(1.0));
    vec4 color = texture(inputImage, uv);
    imageStore(outputImage, coord, color);
}