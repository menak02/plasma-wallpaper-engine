#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D inputImage;
layout(set = 0, binding = 1) uniform sampler2D maskImage;
layout(set = 0, binding = 2) uniform writeonly image2D outputImage;

layout(push_constant) uniform WaveParams {
    float speed;
    float scale;
    float strength;
    float direction;
    float time;
    uint width;
    uint height;
} params;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= int(params.width) || coord.y >= int(params.height)) {
        return;
    }

    // Calculate wave offset
    float phase = params.time * params.speed * 3.0;
    float waveAmp = params.strength * 15.0;

    float dx = cos(params.direction) * sin(phase) * waveAmp;
    float dy = sin(params.direction) * cos(phase) * waveAmp;

    // Apply mask influence
    float maskVal = texture(maskImage, vec2(float(coord.x) / float(params.width), float(coord.y) / float(params.height))).r;
    dx *= maskVal;
    dy *= maskVal;

    // Sample input with wave distortion
    vec2 uv = vec2(
        (float(coord.x) + dx) / float(params.width),
        (float(coord.y) + dy) / float(params.height)
    );

    // Clamp UV coordinates
    uv = clamp(uv, vec2(0.0), vec2(1.0));

    vec4 color = texture(inputImage, uv);
    imageStore(outputImage, coord, color);
}