#pragma once

#include <vector>
#include <string>
#include <memory>
#include <cstdint>
#include <span>

namespace WallpaperEngine::Assets {

enum class TextureFormat : uint32_t {
    Unknown = 0,
    ARGB8888 = 1,
    RGB888 = 2,
    RGB565 = 3,
    DXT1 = 4,
    DXT3 = 5,
    RG88 = 6,
    DXT5 = 7,
    R8 = 8,
    RG1616F = 9,
    R16F = 10,
    BC7 = 11,
    RGBA1010102 = 12,
    RGBA16161616F = 13,
    RGB161616F = 14
};

struct Mipmap {
    uint32_t width = 0;
    uint32_t height = 0;
    std::vector<uint8_t> data;
};

struct TexImage {
    TextureFormat format = TextureFormat::Unknown;
    uint32_t width = 0;
    uint32_t height = 0;
    uint32_t textureWidth = 0;
    uint32_t textureHeight = 0;
    uint32_t flags = 0;
    std::vector<Mipmap> mipmaps;
};

class TexParser {
public:
    static bool parse(std::span<const uint8_t> bytes, TexImage& outImage);
};

} // namespace WallpaperEngine::Assets
